.DS_Store
.vscode
*.token
/build
/dist
data-dev/

# the client's dependencies
internal/presentation/node_modules

# server build outputs and the local state a running server writes
/*.db
/*.db-journal
/*.lock
/*.crt
/*.json
/*.key
/*.ini
/*.sqlite
/__debug_bin
/autocert
/rdio-scanner
/internal/presentation/scanner/frontend/bundle/*
!/internal/presentation/scanner/frontend/bundle/.gitkeep
/internal/presentation/admin/frontend/bundle/*
!/internal/presentation/admin/frontend/bundle/.gitkeep

# the ffmpeg this project compiles per target: the gzipped pair the server binary embeds, and the
# scratch the compile runs in. Deleting either costs a rebuild and nothing else.
/internal/infrastructure/ffmpeg/bundle/*/*
!/internal/infrastructure/ffmpeg/bundle/*/.gitkeep
/.build/

# the ffmpeg and ffprobe binaries dropped at the repo root for local runs. The server embeds its
# own copies, so these are scratch: deleting them costs a re-download and nothing else.
/ffmpeg/
