# The container one target's ffmpeg is compiled in, and the container that target's compiled ffmpeg is
# checked in. It is a build-time artifact: nothing in the runtime image comes from it.
#
# One file serves every target because the only things that differ between them are the base image and
# the packages, and both are recorded in the manifest. Debian's cross toolchains compile every Linux
# target from one amd64 container, which is the choice measured for and took over emulating
# each target's own compiler. The
# Windows target is a mingw cross compile. The check container is a second argument because a
# cross-compiled binary needs an interpreter to run, and a Windows program needs an operating system.
#
# The build context is an empty directory on purpose: this image is a toolchain, and nothing of this
# repository belongs in it.
ARG base=docker.io/debian:stable
FROM ${base}

LABEL maintainer="Chrystian Huot <chrystian.huot@saubeo.solutions>"

# The toolchain that compiles the target, plus whatever runs the program it produced: qemu-user-static
# for a Linux target compiled for another architecture, wine for the Windows one.
ARG packages=build-essential

RUN if command -v apt-get >/dev/null 2>&1; then \
        apt-get update && \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ${packages} && \
        rm -rf /var/lib/apt/lists/*; \
    else \
        apk add --no-cache ${packages}; \
    fi

WORKDIR /work
