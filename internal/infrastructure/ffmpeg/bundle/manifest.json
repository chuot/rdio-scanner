{
  "ffmpeg": "9.0.2",
  "source": {
    "url": "https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz",
    "sha256": "8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"
  },
  "recipe": [
    "--disable-everything",
    "--disable-autodetect",
    "--disable-network",
    "--disable-doc",
    "--disable-ffplay",
    "--enable-ffmpeg",
    "--enable-ffprobe",
    "--disable-asm",
    "--enable-static",
    "--disable-shared",
    "--enable-protocol=pipe",
    "--enable-protocol=fd",
    "--enable-protocol=file",
    "--enable-demuxer=wav",
    "--enable-demuxer=mp3",
    "--enable-demuxer=mov",
    "--enable-decoder=pcm_s16le",
    "--enable-decoder=pcm_s16be",
    "--enable-decoder=pcm_s24le",
    "--enable-decoder=pcm_f32le",
    "--enable-decoder=pcm_mulaw",
    "--enable-decoder=pcm_alaw",
    "--enable-decoder=mp3float",
    "--enable-decoder=mp3",
    "--enable-encoder=aac",
    "--enable-muxer=ipod",
    "--enable-filter=aformat",
    "--enable-filter=aresample",
    "--enable-filter=apad",
    "--enable-filter=loudnorm"
  ],
  "targets": {
    "linux-amd64": {
      "container": "docker.io/debian:stable",
      "packages": [
        "build-essential"
      ],
      "ldflags": [
        "-static"
      ],
      "conformance": {
        "container": "",
        "packages": [],
        "run": []
      }
    },
    "linux-arm64": {
      "container": "docker.io/debian:stable",
      "packages": [
        "build-essential",
        "gcc-aarch64-linux-gnu",
        "libc6-dev-arm64-cross"
      ],
      "cross": [
        "--enable-cross-compile",
        "--target-os=linux",
        "--arch=aarch64",
        "--cross-prefix=aarch64-linux-gnu-"
      ],
      "ldflags": [
        "-static"
      ],
      "conformance": {
        "container": "",
        "packages": [
          "qemu-user-static"
        ],
        "run": [
          "qemu-aarch64"
        ]
      }
    },
    "linux-arm": {
      "container": "docker.io/debian:stable",
      "packages": [
        "build-essential",
        "gcc-arm-linux-gnueabihf",
        "libc6-dev-armhf-cross"
      ],
      "cross": [
        "--enable-cross-compile",
        "--target-os=linux",
        "--arch=arm",
        "--cross-prefix=arm-linux-gnueabihf-"
      ],
      "ldflags": [
        "-static"
      ],
      "conformance": {
        "container": "",
        "packages": [
          "qemu-user-static"
        ],
        "run": [
          "qemu-arm"
        ]
      }
    },
    "linux-386": {
      "container": "docker.io/debian:stable",
      "packages": [
        "build-essential",
        "gcc-multilib",
        "libc6-dev-i386"
      ],
      "cflags": [
        "-m32"
      ],
      "ldflags": [
        "-static",
        "-m32"
      ],
      "conformance": {
        "container": "",
        "packages": [
          "qemu-user-static"
        ],
        "run": [
          "qemu-i386"
        ]
      }
    },
    "windows-amd64": {
      "container": "docker.io/alpine:latest",
      "packages": [
        "build-base",
        "mingw-w64-gcc"
      ],
      "cross": [
        "--enable-cross-compile",
        "--target-os=win64",
        "--arch=x86_64",
        "--cross-prefix=x86_64-w64-mingw32-"
      ],
      "ldflags": [
        "-static",
        "-static-libgcc"
      ],
      "conformance": {
        "container": "docker.io/debian:stable",
        "packages": [
          "wine"
        ],
        "run": [
          "wine"
        ]
      }
    },
    "macos-amd64": {
      "produced": "supplied",
      "cflags": [
        "-mmacosx-version-min=11.0"
      ],
      "ldflags": [
        "-mmacosx-version-min=11.0"
      ]
    },
    "macos-arm64": {
      "produced": "supplied",
      "cflags": [
        "-mmacosx-version-min=11.0"
      ],
      "ldflags": [
        "-mmacosx-version-min=11.0"
      ]
    },
    "freebsd-amd64": {
      "container": "docker.io/debian:stable",
      "containerfile": "Containerfile.ffmpeg.freebsd",
      "packages": [
        "build-essential",
        "clang",
        "lld",
        "curl",
        "ca-certificates",
        "tar",
        "xz-utils",
        "python3"
      ],
      "cross": [
        "--enable-cross-compile",
        "--target-os=freebsd",
        "--arch=x86_64"
      ],
      "cc": "clang --target=x86_64-unknown-freebsd --sysroot=/sysroot",
      "cflags": [
        "--sysroot=/sysroot"
      ],
      "ldflags": [
        "-static",
        "-fuse-ld=lld",
        "--sysroot=/sysroot"
      ],
      "sysroot_image": "docker.io/freebsd/freebsd-toolchain:15.1",
      "conformance": {
        "freebsd_vm": {
          "release": "15.1-RELEASE",
          "url": "https://download.freebsd.org/ftp/releases/VM-IMAGES/15.1-RELEASE/amd64/Latest/FreeBSD-15.1-RELEASE-amd64-BASIC-CLOUDINIT-ufs.qcow2.xz",
          "sha256": "e4ca4db889f8559c9b9dfcacc70405c038476f4b6d41649b152d3809a2ed9e1f",
          "bytes": 2671443968
        }
      }
    }
  }
}
