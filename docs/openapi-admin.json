                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The units as re-read from the database, order renumbered 1-based",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Unit"
                  }
                }
              }
            }
          },
          "400": {
