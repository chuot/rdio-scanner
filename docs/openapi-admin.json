      "put": {
        "summary": "Save the talkgroups of one system",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Talkgroup"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The talkgroups as re-read from the database, order renumbered 1-based",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Talkgroup"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Undecodable body (array expected)"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Unknown system"
          },
          "405": {
            "description": "Unsupported method or WebSocket upgrade on a sub-section path"
          },
          "417": {
            "description": "Persistence failure"
          }
        }
      }
    },
