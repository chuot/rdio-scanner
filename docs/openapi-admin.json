{
  "openapi": "3.1.0",
  "info": {
    "title": "Rdio Scanner Admin API",
    "version": "7.1.0",
    "description": "Admin REST surface of the Rdio Scanner server: authentication, whole-config access (legacy, unchanged), per-section config endpoints (REQ-019, decision-admin-section-api.md), alerts, logs, password change, access user management, and the two call capture endpoints. Auth: raw JWT in the Authorization header, no Bearer prefix. HTTP 401 on invalid/expired token. The capture endpoints authenticate with the key form field. The admin config WebSocket (ws://host/api/admin/config, JWT as first message) is out of scope for this document."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as the webapp"
    }
  ],
  "security": [
    {
      "adminJwt": []
    }
  ],
  "paths": {
    "/api/admin/login": {
      "post": {
        "summary": "Log in and obtain a JWT",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Undecodable body"
          },
          "401": {
            "description": "Wrong password or rate limit exceeded (3 attempts per IP, counter cleared on success)"
          }
        }
      }
    },
    "/api/admin/logout": {
      "post": {
        "summary": "Invalidate the current token",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "responses": {
          "200": {
            "description": "Empty body"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/admin/config": {
      "get": {
        "summary": "Read the whole config (legacy endpoint, kept unchanged)",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WholeConfigResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "summary": "Replace config sections via a whole-config body (legacy endpoint, kept unchanged). Only the top-level keys present in the body are applied.",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WholeConfigResponse"
                }
              }
            }
          },
          "400": {
            "description": "Undecodable body"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "417": {
            "description": "Persistence failure"
          }
        }
      }
    },
    "/api/admin/config/{section}": {
      "parameters": [
        {
          "name": "section",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "access",
              "apikeys",
              "dirwatch",
              "downstreams",
              "groups",
              "options",
              "systems",
              "tags"
            ]
          }
        }
      ],
      "get": {
        "summary": "Read a single config section",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Access"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Apikey"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Dirwatch"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Downstream"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Group"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/Options"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/System"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Tag"
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Unknown section"
          }
        }
      },
      "put": {
        "summary": "Replace a single config section. Persists only that section, then broadcasts the full config to admin WebSocket clients.",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Access"
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Apikey"
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Dirwatch"
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Downstream"
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Group"
                    }
                  },
                  {
                    "$ref": "#/components/schemas/Options"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/System"
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Tag"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated section as re-read from the database",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Access"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Apikey"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Dirwatch"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Downstream"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Group"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/Options"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/System"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Tag"
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Undecodable body (array expected for list sections, object for options)"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Unknown section"
          },
          "405": {
            "description": "Unsupported method or WebSocket upgrade on a section path"
          },
          "417": {
            "description": "Persistence failure"
          }
        }
      }
    },
    "/api/admin/config/systems/{systemId}/sites": {
      "parameters": [
        {
          "name": "systemId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "description": "The system whose level is read or saved"
        }
      ],
      "get": {
        "summary": "Read the sites of one system",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "responses": {
          "200": {
            "description": "The sites stored under the system",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Site"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Unknown system"
          }
        }
      },
      "put": {
        "summary": "Save the sites of one system",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Site"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The sites as re-read from the database, order renumbered 1-based",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Site"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Undecodable body (array expected)"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Unknown system"
          },
          "405": {
            "description": "Unsupported method or WebSocket upgrade on a sub-section path"
          },
          "417": {
            "description": "Persistence failure"
          }
        }
      }
    },
    "/api/admin/config/systems/{systemId}/talkgroups": {
      "parameters": [
