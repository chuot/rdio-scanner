          }
        }
      }
    },
    "/api/admin/alerts": {
      "get": {
        "summary": "Named alert oscillator sequences",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/OscillatorData"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/admin/logs": {
      "post": {
        "summary": "Search log entries",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogsQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Undecodable body"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "417": {
            "description": "Search failure"
          }
        }
      }
    },
    "/api/admin/password": {
      "post": {
        "summary": "Change the admin password",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing newPassword"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "417": {
            "description": "Current password invalid or persistence failure"
          }
        }
      }
    },
    "/api/admin/user-add": {
      "post": {
        "summary": "Add an access user",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Access"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User saved"
          },
          "400": {
            "description": "Undecodable body"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "417": {
            "description": "Validation or persistence failure"
          }
        }
      }
    },
    "/api/admin/user-remove": {
      "post": {
        "summary": "Remove every access code sharing the given user name",
        "security": [
          {
            "adminJwt": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ident"
                ],
                "properties": {
                  "ident": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User removed, or no access code matched the name"
          },
          "400": {
            "description": "Undecodable body"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "417": {
            "description": "Persistence failure"
          }
        }
      }
    },
    "/api/call-upload": {
      "post": {
        "summary": "Upload a call as a set of multipart form fields; the apikey credential is the key form field",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "key",
                  "audio"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "audio": {
                    "type": "string",
                    "format": "binary"
                  },
                  "audioFilename": {
                    "type": "string"
                  },
                  "audioMime": {
                    "type": "string"
                  },
                  "system": {
                    "type": "string"
                  },
                  "talkgroup": {
                    "type": "string"
                  },
                  "talkgroupLabel": {
                    "type": "string"
                  },
                  "talkgroupName": {
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "string"
                  },
                  "site": {
                    "type": "string"
                  },
                  "frequencies": {
                    "type": "string"
                  },
                  "patches": {
                    "type": "string"
                  },
                  "sources": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Call imported successfully."
          },
          "400": {
            "description": "Not a multipart content, or a body the reader cannot parse"
          },
          "403": {
            "description": "Invalid API key for the call"
          },
          "417": {
            "description": "Upload failure"
          }
        }
      }
    },
    "/api/trunk-recorder-call-upload": {
      "post": {
        "summary": "Upload a trunk-recorder call: the JSON sidecar in the meta field and the recording in the audio field",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "key",
                  "meta",
                  "audio"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "meta": {
                    "type": "string",
                    "description": "The trunk-recorder sidecar JSON document"
                  },
                  "audio": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Call imported successfully."
          },
          "400": {
            "description": "Not a multipart content, or a body the reader cannot parse"
          },
          "403": {
            "description": "Invalid API key for the call"
          },
          "417": {
            "description": "Upload failure"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminJwt": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Raw JWT from POST /api/admin/login, no Bearer prefix. HS256, no expiry; the server keeps the last 5 issued tokens."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, invalid, or expired token — the client must clear its session"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "passwordNeedChange": {
            "type": "boolean"
          }
        }
      },
      "WholeConfigResponse": {
        "type": "object",
        "properties": {
          "config": {
            "$ref": "#/components/schemas/Config"
          },
          "docker": {
            "type": "boolean"
          },
          "passwordNeedChange": {
            "type": "boolean"
          }
        }
      },
      "Config": {
        "type": "object",
        "properties": {
          "access": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Access"
            }
          },
          "apikeys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Apikey"
            }
          },
          "dirwatch": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Dirwatch"
            }
          },
          "downstreams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Downstream"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Group"
            }
          },
          "options": {
            "$ref": "#/components/schemas/Options"
          },
          "systems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/System"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "SystemsScope": {
        "description": "'*' means everything; otherwise a list of system ids or {id, talkgroups} objects",
        "oneOf": [
          {
            "type": "string",
            "const": "*"
          },
          {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "object",
                  "properties": {
